<UserControl x:Class="VoidShot.Controls.AboutMenuControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:Ant="clr-namespace:AntWpf.Controls;assembly=AntWpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    mc:Ignorable="d">
    <ScrollViewer x:Name="AboutMenu"
        VerticalScrollBarVisibility="Auto"
        PanningMode="VerticalOnly">
        <StackPanel Margin="20">

            <!-- Hero Section -->
            <Border Background="#15FFFFFF"
                BorderBrush="#3FFFFFFF"
                BorderThickness="1"
                CornerRadius="5"
                Padding="24"
                Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Free Notice -->
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">
                        <Label Content="&#xE946;"
                            FontFamily="Segoe MDL2 Assets"
                            Foreground="#80FFFFFF"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Padding="0,0,4,0" />
                        <Label Content="VoidShot By Void."
                            FontFamily="{StaticResource Atkinson Hyperlegible}"
                            Foreground="#80FFFFFF"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Padding="0" />
                    </StackPanel>

                    <!-- Logo -->
                    <Path x:Name="AboutVoidShotLogo"
                        Fill="White"
                        Stretch="Fill"
                        HorizontalAlignment="Center"
                        Width="80"
                        Height="40"
                        Margin="0,0,0,12">
                        <Path.Data>
                            <PathGeometry
                                Figures="M 18.2472,490.72756 0.18686636,472.66723 153.0173,318.84293 305.84774,165.01862 l 17.74245,17.70593 17.74244,17.70592 17.0189,-16.98112 c 9.36039,-9.33961 17.60957,-16.98112 18.33151,-16.98112 0.72194,0 69.86022,68.54563 153.64061,152.32363 l 152.32798,152.32362 -18.32581,18.45368 -18.3258,18.45368 -152.3021,-153.11064 -152.3021,-153.11063 -20.36457,20.6423 C 309.83073,233.79713 241.18587,302.86906 168.4871,375.93703 L 36.307534,508.7879 Z"
                                FillRule="NonZero" />
                        </Path.Data>
                    </Path>

                    <!-- Title & Version -->
                    <TextBlock Text="VoidShot"
                        FontFamily="{StaticResource Atkinson Hyperlegible}"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="White"
                        HorizontalAlignment="Center" />
                    <TextBlock Text="Universal Second Eye"
                        FontFamily="{StaticResource Atkinson Hyperlegible}"
                        FontSize="12"
                        Foreground="#99FFFFFF"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,8" />
                    <Border x:Name="VersionBorder"
                        Background="{DynamicResource ThemeColor}"
                        CornerRadius="5"
                        Padding="12,4"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        MouseLeftButtonUp="VersionBorder_Click">
                        <Label x:Name="AboutDesc"
                            Content="v1.0.0"
                            FontFamily="{StaticResource Atkinson Hyperlegible}"
                            FontSize="11"
                            Foreground="White"
                            Padding="0" />
                    </Border>

                    <!-- System Specs -->
                    <Label x:Name="AboutSpecs"
                        Content="Intel I5-13400F | NVIDIA GTX 1050"
                        FontFamily="{StaticResource Atkinson Hyperlegible}"
                        Foreground="#60FFFFFF"
                        FontSize="10"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Padding="0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>